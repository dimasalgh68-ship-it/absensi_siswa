# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# 
# INSTRUKSI:
# 1. Copy file ini ke .env
# 2. Sesuaikan semua nilai dengan konfigurasi server Anda
# 3. Generate APP_KEY dengan: php artisan key:generate
# 4. JANGAN commit file .env ke Git!

# ============================================
# APPLICATION
# ============================================

APP_NAME="Absensi Karyawan"
APP_ENV=production
APP_DEBUG=false
APP_KEY=

APP_TIMEZONE=Asia/Jakarta
APP_URL=https://yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ============================================
# LOGGING
# ============================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE
# ============================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_absensi_karyawan
DB_USERNAME=db_user
DB_PASSWORD=your_secure_password_here

# ============================================
# SESSION & CACHE
# ============================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ============================================
# REDIS (Optional - jika menggunakan Redis)
# ============================================

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MAIL CONFIGURATION
# ============================================

# Untuk Gmail:
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk Mailgun:
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-domain.com
# MAILGUN_SECRET=your-mailgun-secret
# MAILGUN_ENDPOINT=api.mailgun.net

# Untuk SendGrid:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_ENCRYPTION=tls

# ============================================
# AWS (Optional - jika menggunakan S3)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# PUSHER (Optional - jika menggunakan broadcasting)
# ============================================

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# ============================================
# VITE
# ============================================

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# FACE RECOGNITION API
# ============================================

# Endpoint API Face Recognition
# Jika menggunakan Python API lokal: http://localhost:5000/api
# Jika menggunakan cloud service: https://api.yourdomain.com
FACE_RECOGNITION_ENDPOINT=http://localhost:5000/api

# API Key untuk autentikasi (optional)
FACE_RECOGNITION_API_KEY=

# Threshold untuk face matching (0.0 - 1.0)
# Semakin tinggi = semakin strict
# Recommended: 0.85 - 0.95
FACE_RECOGNITION_THRESHOLD=0.90

# ============================================
# SECURITY SETTINGS
# ============================================

# Force HTTPS (set true jika sudah install SSL)
FORCE_HTTPS=true

# Session security
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ============================================
# PERFORMANCE SETTINGS
# ============================================

# Opcache (PHP)
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=10000

# Query logging (disable di production untuk performa)
DB_LOG_QUERIES=false

# ============================================
# BACKUP SETTINGS (Optional)
# ============================================

BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=admin@yourdomain.com

# ============================================
# MONITORING (Optional)
# ============================================

# Sentry (Error tracking)
SENTRY_LARAVEL_DSN=

# Google Analytics
GOOGLE_ANALYTICS_ID=

# ============================================
# NOTES
# ============================================
# 
# SECURITY CHECKLIST:
# - [ ] APP_DEBUG=false
# - [ ] APP_ENV=production
# - [ ] Strong DB_PASSWORD
# - [ ] APP_KEY generated
# - [ ] SSL Certificate installed
# - [ ] FORCE_HTTPS=true
# - [ ] File .env tidak bisa diakses via browser
# - [ ] Backup database regular
# - [ ] Monitor logs regular
# 
# PERFORMANCE CHECKLIST:
# - [ ] Config cached: php artisan config:cache
# - [ ] Routes cached: php artisan route:cache
# - [ ] Views cached: php artisan view:cache
# - [ ] Opcache enabled
# - [ ] Redis/Memcached (optional)
# - [ ] CDN untuk assets (optional)
# 
# MAINTENANCE:
# - Update dependencies monthly
# - Check logs weekly
# - Backup database daily
# - Monitor disk space
# - Test restore procedure
